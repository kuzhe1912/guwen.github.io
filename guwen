// ========== 核心分析 ==========
function runAnalysis() {
    const text = document.getElementById('inputText').value;
    if (!text.trim()) {
        document.getElementById('resultArea').innerHTML = '';
        document.getElementById('totalChars').textContent = '0';
        document.getElementById('hitCount').textContent = '0';
        document.getElementById('uniqueHits').textContent = '0';
        return;
    }

    const charsOnly = text.replace(/[^\u4e00-\u9fa5]/g, '');
    const totalChars = charsOnly.length;

    const paragraphs = text.split(/\n+/).filter(p => p.trim());
    function splitSentences(para) {
        return para.match(/[^。？！；]+[。？！；]*/g) || [para];
    }

    let positions = {};
    let freq = {};
    let paraSents = [];

    for (let pi = 0; pi < paragraphs.length; pi++) {
        const sents = splitSentences(paragraphs[pi]);
        paraSents.push(sents);
        for (let si = 0; si < sents.length; si++) {
            const sent = sents[si];
            const sentChars = sent.split('');
            for (let ci = 0; ci < sentChars.length; ci++) {
                const ch = sentChars[ci];
                if (/[\u4e00-\u9fa5]/.test(ch)) {
                    if (!positions[ch]) positions[ch] = [];
                    positions[ch].push({ paraIdx: pi, sentIdx: si, charIdx: ci });
                    freq[ch] = (freq[ch] || 0) + 1;
                }
            }
        }
    }

    let hitChars = Object.keys(freq).filter(ch => dictData.hasOwnProperty(ch));
    if (hitChars.length === 0) {
        document.getElementById('resultArea').innerHTML = '<p style="color:#888;text-align:center;">未命中任何字库中的字。</p>';
        document.getElementById('totalChars').textContent = totalChars;
        document.getElementById('hitCount').textContent = '0';
        document.getElementById('uniqueHits').textContent = '0';
        return;
    }

    const maxFreq = Math.max(...hitChars.map(ch => freq[ch]));
    const itemsOf = ch => (SW_DICT[ch] ? SW_DICT[ch][1].length : (dictData[ch] ? dictData[ch].items : 1));
    const maxItems = Math.max(...hitChars.map(itemsOf));

    let scores = {};
    for (let ch of hitChars) {
        const d = dictData[ch];
        const freqNorm = maxFreq > 0 ? freq[ch] / maxFreq : 0;
        const examNorm = EXAM_MAP[d.exam] / 4;
        const itemsNorm = maxItems > 0 ? itemsOf(ch) / maxItems : 0;
        const diffNorm = DIFF_MAP[d.diff] / 3;
        const totalW = WEIGHTS.freq + WEIGHTS.exam + WEIGHTS.items + WEIGHTS.diff;
        const w1 = WEIGHTS.freq / totalW;
        const w2 = WEIGHTS.exam / totalW;
        const w3 = WEIGHTS.items / totalW;
        const w4 = WEIGHTS.diff / totalW;
        const score = (freqNorm * w1 + examNorm * w2 + itemsNorm * w3 + diffNorm * w4) * 100;
        scores[ch] = Math.round(score * 10) / 10;
    }

    hitChars.sort((a,b) => scores[b] - scores[a]);

    const uniqueHitCount = hitChars.length;
    const totalHitCount = hitChars.reduce((sum,ch)=>sum+freq[ch],0);

    document.getElementById('totalChars').textContent = totalChars;
    document.getElementById('hitCount').textContent = totalHitCount;
    document.getElementById('uniqueHits').textContent = uniqueHitCount;

    let html = '';
    for (let ch of hitChars) {
        const score = scores[ch];
        const freqVal = freq[ch];
        const posList = positions[ch];
        let contexts = [];
        const seen = new Set();
        for (let pos of posList) {
            const sent = paraSents[pos.paraIdx][pos.sentIdx];
            if (seen.has(sent)) continue;
            seen.add(sent);
            const idx = pos.charIdx;
            const start = Math.max(0, idx - 8);
            const end = Math.min(sent.length, idx + 9);
            let ctx = sent.substring(start, end);
            const re = new RegExp(ch, 'g');
            ctx = ctx.replace(re, `<em>${ch}</em>`);
            contexts.push(ctx);
            if (contexts.length >= 3) break;
        }
        const [swText, senses] = getEntry(ch);
        const senseHtml = senses.map(s => {
            const i = s.indexOf('/');
            const zh = i > -1 ? s.slice(0, i).trim() : s;
            const en = i > -1 ? s.slice(i + 1).trim() : '';
            return `<li><span class="zh">${zh}</span>${en ? `<span class="en">${en}</span>` : ''}</li>`;
        }).join('');

        html += `
        <div class="card" onclick="this.classList.toggle('open')">
            <div class="card-header">
                <span class="char-big">${ch}</span>
                <span class="value-score">价值分 ${score}</span>
                <span class="pinyin">${getPinyin(ch)}</span>
                <span class="freq-badge">出现 ${freqVal} 次</span>
            </div>
            <div class="card-body">
                <div class="ben-yi">${swText}</div>
                <div class="senses">
                    <div class="senses-title">义项 · ${senses.length} 项</div>
                    <ol>${senseHtml}</ol>
                </div>
                <div class="context">
                    ${contexts.join('　｜　')}
                </div>
            </div>
        </div>`;
    }
    document.getElementById('resultArea').innerHTML = html;
}

// 防抖自动运行
let debounceTimer;
function autoRun() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(runAnalysis, 400);
}

window.onload = function() {
    runAnalysis();
};
